# Salin file ini menjadi .env.local untuk pengembangan lokal.

# Wajib — kunci publik, di-bundle ke browser, diamankan oleh RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Opsional tapi disarankan — RAHASIA, jangan pernah di-commit.
# Dipakai /api/admin/drivers untuk membuat akun driver lewat Admin API.
# Tanpa ini, route jatuh ke fallback signUp anon (driver harus verifikasi email sendiri).
# Isi lewat Vercel → Settings → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
