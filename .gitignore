.env
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-pwa generated service worker
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
